# =====================================================================
# SkyWalking Java Agent 关键配置（测试环境示例）
# 该文件放在 agent 根目录，与 skywalking-agent.jar 同级。
# 也可用 JVM 参数覆盖：-Dskywalking.agent.service_name=xxx
# =====================================================================

# 服务名（在 SkyWalking UI 中显示的名称）
agent.service_name=${SW_AGENT_NAME:skywalking-demo}

# OAP 后端地址（gRPC，对应 docker-compose 暴露的 11800）
collector.backend_service=${SW_AGENT_COLLECTOR_BACKEND_SERVICES:127.0.0.1:11800}

# 采集 JDBC SQL 参数（仅测试环境开启！生产必须关闭，防止泄露敏感数据 + 性能开销）
plugin.jdbc.trace_sql_parameters=true

# SQL 参数截断长度（默认 512，调大避免长参数被截断）
# 注意：规格里常被写成 plugin.jdbc.max_sql_length，实际有效的 key 是本项
plugin.jdbc.sql_parameters_max_length=2048
